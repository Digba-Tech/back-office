# Backend's public origin (no path suffix) — used for both SuperTokens auth
# (apiBasePath "/auth") and as the base of VITE_API_BASE_URL below.
VITE_API_DOMAIN=https://staging-api.digba-tech.com

# Base URL of this backend's admin API (admin routes live under /admin on this).
VITE_API_BASE_URL=https://staging-api.digba-tech.com/api/v2
